{
  "name": "relay-desktop",
  "productName": "Relay",
  "desktopName": "dev.relay.desktop.desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first desktop automation workbench",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "build:native": "cargo build --manifest-path native/Cargo.toml --release",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && npm run build:native && electron-builder",
    "check": "npm run typecheck && npm test",
    "test:smoke": "node scripts/smoke.mjs",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:native": "node scripts/native-harness.mjs",
    "test:native:windows": "node scripts/windows-native-matrix.mjs",
    "format": "prettier --write src tests scripts docs README.md package.json *.json *.ts *.html .github/workflows/*.yml",
    "install:browser": "playwright install chromium",
    "test:native:macos": "node scripts/macos-native-matrix.mjs",
    "test:native:wayland": "node scripts/wayland-native-matrix.mjs",
    "test:ai:live": "node scripts/ai-conformance.mjs",
    "test:ai:harness": "node scripts/ai-conformance-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/openai-compatible": "3.0.75",
    "@radix-ui/react-dialog": "1.3.1",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.148",
    "ajv": "8.20.0",
    "lucide-react": "1.61.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "dev.relay.desktop",
    "productName": "Relay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/@techstark/opencv-js/**/*"
    ],
    "extraResources": [
      {
        "from": "native/target/release",
        "to": "native",
        "filter": [
          "relay-native",
          "relay-native.exe"
        ]
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Relay captures selected windows for recording and visual detection."
      },
      "minimumSystemVersion": "14.0.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
